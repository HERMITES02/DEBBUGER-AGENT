# -- LLM ----------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here

# -- Model selection -----------------------------------
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-5
MODEL_VISION=claude-sonnet-4-5

# -- Tools ---------------------------------------------
TAVILY_API_KEY=your_tavily_key_here
E2B_API_KEY=your_e2b_key_here

# -- Redis (use Upstash or RedisLabs) -----------------
REDIS_URL=redis://default:password@host:port

# -- Auth ----------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string

# -- Database (SQLite for dev, set path for prod) ------
DATABASE_URL=sqlite+aiosqlite:///./users.db

# -- CORS — set to your Vercel frontend URL ------------
# Comma-separated for multiple origins
CORS_ORIGINS=https://your-app.vercel.app,https://your-preview.vercel.app
