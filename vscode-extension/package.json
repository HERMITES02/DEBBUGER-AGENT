{
  "name": "debugger-agent",
  "displayName": "Debugger Agent",
  "description": "AI-powered multi-agent debugger — select code, right-click, and watch the live agent flowchart diagnose and fix your bugs.",
  "version": "0.1.0",
  "publisher": "debugger-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jatin5233/DEBBUGER-AGENT.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onCommand:debugAgent.debug",
    "onCommand:debugAgent.setToken"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "debugAgent.debug",
        "title": "🐛 Debug with Agent",
        "category": "Debugger Agent"
      },
      {
        "command": "debugAgent.setToken",
        "title": "🔑 Set API Token",
        "category": "Debugger Agent"
      },
      {
        "command": "debugAgent.clearToken",
        "title": "🗑️ Clear API Token",
        "category": "Debugger Agent"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "debugAgent.debug",
          "group": "9_debugagent@1"
        }
      ]
    },
    "configuration": {
      "title": "Debugger Agent",
      "properties": {
        "debugAgent.backendUrl": {
          "type": "string",
          "default": "https://debbuger-agent.onrender.com",
          "description": "Base URL of the Debugger Agent FastAPI backend"
        },
        "debugAgent.autoSaveSession": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save debug sessions when a result is received"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "bundledDependencies": [
    "uuid",
    "ws"
  ]
}
